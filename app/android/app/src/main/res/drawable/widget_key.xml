<?xml version="1.0" encoding="utf-8"?>
<!-- Same key color and radius as the app (Tokens.key / rKey); lighter while pressed. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle"><solid android:color="#3A3F47" /><corners android:radius="12dp" /></shape>
    </item>
    <item>
        <shape android:shape="rectangle"><solid android:color="#26282D" /><corners android:radius="12dp" /></shape>
    </item>
</selector>
